<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.claudeinfra.ops-agent</string>

    <key>WorkingDirectory</key>
    <string>/Users/Till/Projects/claude-infrastructure</string>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/zsh</string>
      <string>-lc</string>
      <string>cd /Users/Till/Projects/claude-infrastructure &amp;&amp; npm run ops:run</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
      <key>Hour</key>
      <integer>8</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/Till/Projects/claude-infrastructure/reports/ops/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/Till/Projects/claude-infrastructure/reports/ops/launchd.err.log</string>

    <key>RunAtLoad</key>
    <true/>
  </dict>
</plist>
